# SPA + 后端反代（nginx 官方镜像的 /etc/nginx/templates 会用环境变量渲染 *.template）
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # 前端路由（BrowserRouter 需要 try_files 回退）
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 与 Vite dev proxy 对齐：同域反代后端，生产无跨域
    location /seckill {
        proxy_pass ${BACKEND_ORIGIN};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /api/ai {
        proxy_pass ${BACKEND_ORIGIN};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
