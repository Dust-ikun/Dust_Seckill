      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "seckill-prometheus"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{uri=\"/seckill\"}[5m])) - sum(rate(http_server_requests_seconds_bucket{uri=\"/seckill\",le=\"1.0\"}[5m]))",
          "legendFormat": "慢请求/秒",
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "② Redis：命令 P99",
      "description": "Case 2（Redis 延迟）的特征信号。若 Redis P99 与 API P99 同步抬升、而 MySQL 侧无异常 → 根因在 Redis。",
