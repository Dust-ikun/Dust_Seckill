          "format": "table",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 14,
      "type": "table",
      "title": "需人工介入的欠账明细",
      "description": "终态失败的存量。它们**不会自愈**，且直接对应「少卖」这个业务损失。Agent 给出的建议应当是「调用 /seckill/reconcile 查看对账结论」，而**不是**直接修改数据（SPEC 第 19 节 Case 5 的明确要求）。",
      "datasource": {
        "type": "prometheus",
        "uid": "seckill-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 35,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
