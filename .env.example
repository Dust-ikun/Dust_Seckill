# =============================================================================
#  docker-compose.yml 的环境变量模板
#
#  用法：复制为 .env 后按需修改。
#      Copy-Item .env.example .env        （Windows）
#      cp .env.example .env               （Linux/macOS）
#  或者直接跑一键脚本（缺 .env 时会自动复制）：
#      .\scripts\up.ps1                   （Windows）
#      ./scripts/up.sh                    （Linux/macOS）
#
#  【为什么要有这一层】口令与端口写死在 compose 文件里有两个具体代价：
#   1) compose 文件是要提交到 Git 的，写死等于把口令一起提交；
#   2) 「换端口重跑一遍」是故障注入/对照实验的常见需求，写死后每次都要改文件，
#      改完还容易忘记改回去（于是本地能跑、别人拉下来跑不起来）。
#
#  【注意】.env 已被 .gitignore 忽略。若你修改了这里任何一项，
#  必须同步修改 src/main/resources/application-docker.yaml 里对应的连接配置。
# =============================================================================

# ---------------- 一键拉起 ----------------
# profiles 组合，决定 `docker compose up -d` 默认启动哪些服务：
#   web           → 前端控制台（Nginx 容器，8080）
#   observability → Prometheus / Alertmanager / Grafana
# 中间件与后端（backend）不在任何 profile 里，永远启动。
# 想只起核心链路调试时，把这行改为 COMPOSE_PROFILES= 空即可。
COMPOSE_PROFILES=web,observability

# ---------------- MySQL ----------------
# 容器内始终是 3306；MYSQL_HOST_PORT 是映射到宿主机的端口。
#
# 【为什么现在是 3306 而不是最初的 3307】3307 是为「与原生 MySQL84 并存」选的。
# 决定「本机中间件全部删除、以后只用 Docker」之后，3306 空了出来，
# 于是回到标准端口 —— 收益是 application.yaml 里的连接串一个字都不用改
# （它原本就写 localhost:3306），少一个「为什么端口不一样」的解释成本。
#
# 【代价与前提】容器 MySQL 与原生 MySQL84 **不能同时占用 3306**。
# 必须先把原生服务停掉并禁用开机自启，否则 compose 起不来：
#     Stop-Service MySQL84; Set-Service MySQL84 -StartupType Disabled
#
# 【这里刻意不留默认口令】本文件是要提交的（远程仓库是公开的），
# 而它在 .gitignore 里被特意排除掉的只有 .env 一个 —— 换句话说，
# 写在这里的每一个字符都会进入公开仓库。曾经这里写的是本机真实口令，
# 于是「本机开发默认值」变成了「公开仓库里的口令」，而且没有任何提示。
# 现在留空，并让 compose 用 ${VAR:?...} 在口令缺失时**直接报错**：
# 复制成本文件为 .env 之后必须自己填一次，忘记填会得到一个明确的错误信息，
# 而不是悄悄用一个众所周知的弱口令把 MySQL 跑起来。
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=seckill
MYSQL_HOST_PORT=3306

# ---------------- Redis ----------------
# 同理回到标准 6379。注意另一个项目的 skychat-redis 也绑 6379（当前已停止），
# 两者不能同时启动；需要并存时改成 6380 并同步导出同名环境变量。
REDIS_HOST_PORT=6379

# ---------------- RocketMQ ----------------
ROCKETMQ_NAMESRV_HOST_PORT=9876
ROCKETMQ_BROKER_HOST_PORT=10911
ROCKETMQ_BROKER_HA_HOST_PORT=10909
# Broker 指标导出端口（只绑 127.0.0.1）。
# 【不是 JMX】RocketMQ 5.x 没有 MBean（实测 broker jar 里 0 个 mbean 类），
# 用的是内置的 OTel Prometheus 导出器，见 docker/rocketmq/broker.conf 末尾的说明。
# Prometheus 抓的是 rocketmq-broker:5557（走 compose 网络），这条映射只给宿主机用。
ROCKETMQ_BROKER_METRICS_HOST_PORT=5557

# ---------------- 可观测性 ----------------
PROMETHEUS_HOST_PORT=9090
ALERTMANAGER_HOST_PORT=9093
GRAFANA_HOST_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ---------------- 前端控制台（profile: web） ----------------
# 宿主机访问端口（Nginx 容器内是 80）。
FRONTEND_HOST_PORT=8080
# Nginx 反代的后端地址。后端已容器化，保持 compose 服务名即可；
# 仅当回退到「后端跑宿主机」形态时才改回 http://host.docker.internal:8081。
BACKEND_ORIGIN=http://backend:8081

# ---------------- 后端业务应用（容器化，默认启动） ----------------
# 容器对外只发布到宿主机回环（127.0.0.1），供人调试与压测脚本使用；
# 容器之间（Nginx 反代 / Prometheus 抓取 / Alertmanager webhook）走 compose 网络服务名。
BACKEND_HOST_PORT=8081
BACKEND_MANAGEMENT_HOST_PORT=9091

# ---------------- AI Monitor Agent ----------------
# LLM 的 API Key **不放在这里**。
# ../.env 会被 compose 读取，而 compose 文件常在演示/截图时被共享；
# 因此 LLM Key 只通过应用侧的环境变量传入（见 application-docker.yaml 的
# seckill.monitor.llm.api-key: ${DEEPSEEK_API_KEY:}），
# 且默认值为空 —— 空值时 Agent 自动进入「未配置 LLM」的降级态：
# 仍然接收并落库 Alert，只是不产出 Diagnosis。
# 这是 SPEC 第 18 节「AI 失败 ≠ 监控失败」在配置层面的落点。
